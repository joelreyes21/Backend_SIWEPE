# Copia este archivo a .env y pon tus propios valores:
#   cp .env.example .env

PORT=3000

# Conexión local a MySQL (para correr el backend en tu computadora)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=SIWEPE

# Cambia esto por una frase larga y única tuya — nunca dejes el valor por
# defecto del código en producción, cualquiera podría forjar sesiones.
JWT_SECRET=cambia_esto_por_una_frase_larga_y_unica
JWT_EXPIRES_IN=7d

# Orígenes web autorizados, separados por coma
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SITE_URL=http://localhost:5500
PUBLIC_API_URL=http://localhost:3000

# Opcional: sólo para preparar una instalación sin administradores.
# BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
# BOOTSTRAP_ADMIN_PASSWORD=usa-una-clave-unica-de-12-o-mas

# Correo transaccional (verificación y recuperación)
# RESEND_API_KEY=
# MAIL_FROM=SIWEPE <no-reply@tu-dominio.com>

# Confirmación temporal requerida por `npm run reset -- --empresa=slug`.
# RESET_CONFIRM=BORRAR:slug

# En Railway estas variables (o MYSQL_URL / DATABASE_URL) ya vienen dadas
# automáticamente al conectar un plugin de MySQL — no hace falta copiarlas aquí.
