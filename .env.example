# Copia este archivo a .env y pon tus propios valores:
#   cp .env.example .env

PORT=3000

# Conexión local a MySQL (para correr el backend en tu computadora)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=SIWEPE

# Cambia esto por una frase larga y única tuya — nunca dejes el valor por
# defecto del código en producción, cualquiera podría forjar sesiones.
JWT_SECRET=cambia_esto_por_una_frase_larga_y_unica

# En Railway estas variables (o MYSQL_URL / DATABASE_URL) ya vienen dadas
# automáticamente al conectar un plugin de MySQL — no hace falta copiarlas aquí.
